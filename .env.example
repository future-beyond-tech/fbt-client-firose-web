# Public corporate configuration
NEXT_PUBLIC_SITE_URL=https://firoseenterprises.in

# Publish only after FIROSE confirms that the mailbox is active.
NEXT_PUBLIC_CORPORATE_EMAIL=

# Optional public profiles. Empty values are not rendered.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_AMAZON_STOREFRONT_URL=

# Optional AR Perfumes website override.
NEXT_PUBLIC_AR_BRAND_WEBSITE=

# Server-only business-enquiry delivery configuration.
# The endpoint must accept HTTPS POST requests with a JSON body.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=
ENQUIRY_RECIPIENT_EMAIL=
